rules_version = '2';
// Shared Firebase project for Mangia Mangia, the weather app AND Compora Daily. Friends-only, no accounts:
// anyone with the link can read and write; documents are kept well-formed.
// Paste ALL of this in Firebase → Firestore Database → Rules → Publish (it replaces the old rules,
// so it includes Mangia Mangia's and the weather app's rules unchanged, plus Compora Daily's lists at the bottom).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Mangia Mangia ----
    match /recipes/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.title.size() > 0
                            && request.resource.data.title.size() <= 120;
      match /comments/{cid} { allow read, write: if true; }
    }
    match /photos/{id}    { allow read, write: if true; }
    match /ratings/{id}   { allow read, delete: if true;
                            allow create, update: if request.resource.data.stars is number
                                                  && request.resource.data.stars >= 1
                                                  && request.resource.data.stars <= 5; }
    match /favorites/{id} { allow read, write: if true; }
    match /users/{id}     { allow read, delete: if true;
                            allow create, update: if request.resource.data.name is string
                                                  && request.resource.data.name.size() <= 40; }
    match /battles/{id}     { allow read, write: if true; }
    match /battlevotes/{id} { allow read, write: if true; }

    // ---- Weather app ----
    match /weather_spots/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.lat is number
                            && request.resource.data.lon is number;
    }
    match /weather_log/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.spotId is string
                            && request.resource.data.date is number;
    }

    // ---- Compora Daily (the wall calendar) ----
    // One document holds the grocery list, the to-do list and the dinner plan. Anyone with the link can edit it.
    match /daily_board/{id} {
      allow read: if true;
      allow create, update: if (!("grocery" in request.resource.data) || (request.resource.data.grocery is list && request.resource.data.grocery.size() <= 300))
                            && (!("todo" in request.resource.data) || (request.resource.data.todo is list && request.resource.data.todo.size() <= 300))
                            && (!("dinners" in request.resource.data) || request.resource.data.dinners is map)
                            && (!("extras" in request.resource.data) || (request.resource.data.extras is list && request.resource.data.extras.size() <= 200));
    }
    // What the email/town skimmer found (pending items, the seen-list it uses to avoid repeats, and city trash notices).
    match /daily_inbox/{id} {
      allow read: if true;
      allow create, update: if (!("items" in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 60))
                            && (!("seen" in request.resource.data) || (request.resource.data.seen is list && request.resource.data.seen.size() <= 800))
                            && (!("notices" in request.resource.data) || (request.resource.data.notices is list && request.resource.data.notices.size() <= 20));
    }
  }
}
